DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

RewriteCond %{HTTP_HOST} ^(?:www\.)?fortelescopes\.com$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.fortelescopes\.com$ [NC]
RewriteRule ^ https://fortelescopes.com%{REQUEST_URI} [R=301,L,NE]

RewriteRule ^\.well-known(?:/|$) - [L]
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:includes|scripts|data|templates)(?:/|$) - [F,L,NC]
RewriteRule ^(?:\.env|\.env\.example|composer\.(?:json|lock)|package(?:-lock)?\.json|phpinfo\.php|db\.sql|backup\.sql|database\.sql|dump\.sql|mysql\.sql|upload\.php|uploader\.php|unzip\.php|unzipper\.php)$ - [F,L,NC]

RewriteRule ^wp-admin/setup-config\.php$ - [F,L,NC]
RewriteRule ^wp-admin/install\.php$ - [F,L,NC]
RewriteRule ^wp-login\.php$ - [F,L,NC]
RewriteRule ^wordpress/wp-admin/setup-config\.php$ - [F,L,NC]

RewriteRule ^category/accessories/?$ /accessories [R=301,L,NC]
RewriteRule ^category/telescopes/?$ /telescopes [R=301,L,NC]
RewriteRule ^guides/(.+)/?$ /$1 [R=301,L,NC]

RewriteRule ^sitemap\.xml$ index.php [L,QSA]

RewriteRule ^enma/?$ enma/index.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "^index\.php$">
        Header always unset Expires
        Header always unset Pragma
    </FilesMatch>
</IfModule>
